#!/usr/bin/env python3
# FN network speed

from __future__ import annotations

import argparse
import ctypes
import http.client
import json
import os
import re
import select
import shutil
import socket
import subprocess
import sys
import termios
import threading
import time
import tty
import urllib.error
import urllib.parse
import urllib.request
from collections import deque
from dataclasses import dataclass, field

DOWNLOAD_URL = "https://speed.cloudflare.com/__down?bytes=25000000"
UPLOAD_URL = "https://speed.cloudflare.com/__up"
PING_HOST = "1.1.1.1"
USER_AGENT = "fnnetspeed/2"
DEFAULT_DURATION = 5.0
CHUNK_SIZE = 256 * 1024
UPLOAD_BATCH = 8 * 1024 * 1024
REFRESH_INTERVAL = 0.1
GRAPH_BLOCKS = "▁▂▃▄▅▆▇█"

PALETTE = {
    "accent": (137, 177, 158),
    "secondary": (77, 107, 92),
    "text": (232, 232, 232),
    "muted": (154, 160, 157),
    "dim": (114, 114, 114),
    "error": (208, 139, 139),
}


def mark_process() -> None:
    try:
        ctypes.CDLL(None).prctl(15, b"fnnetspeed", 0, 0, 0)
    except (AttributeError, OSError):
        pass


def run_command(argv: list[str], timeout: float = 3.0) -> str:
    try:
        completed = subprocess.run(
            argv,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return completed.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def connection_info() -> dict[str, str]:
    interface = ""
    route = run_command(["ip", "-json", "route", "get", PING_HOST])
    try:
        rows = json.loads(route)
        if rows and isinstance(rows[0], dict):
            interface = str(rows[0].get("dev", ""))
    except (json.JSONDecodeError, TypeError, ValueError):
        pass

    network = ""
    if interface:
        link = run_command(["iwctl", "station", interface, "show"])
        link = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", link)
        match = re.search(r"^\s*Connected network\s+(.+?)\s*$", link, re.MULTILINE)
        if match:
            network = match.group(1).strip()
    return {
        "interface": interface or "Unknown",
        "network": network or "Wired / unknown",
    }


def latency_ms() -> float | None:
    output = run_command(
        ["ping", "-n", "-q", "-c", "4", "-W", "2", PING_HOST],
        timeout=10,
    )
    match = re.search(r"=\s*[\d.]+/([\d.]+)/", output)
    return round(float(match.group(1)), 1) if match else None


@dataclass
class Metric:
    status: str = "waiting"
    current_mbps: float = 0.0
    average_mbps: float = 0.0
    peak_mbps: float = 0.0
    progress: float = 0.0
    transferred: int = 0
    elapsed: float = 0.0
    samples: deque[float] = field(default_factory=lambda: deque(maxlen=240))
    error: str = ""


class TestState:
    def __init__(self, duration: float) -> None:
        self.duration = duration
        self.lock = threading.Lock()
        self.stop = threading.Event()
        self.done = threading.Event()
        self.phase = "preparing"
        self.network = "Detecting network"
        self.interface = "-"
        self.latency: float | None = None
        self.upload = Metric()
        self.download = Metric()
        self.cancelled = False
        self.fatal_error = ""

    def set_connection(self, data: dict[str, str]) -> None:
        with self.lock:
            self.network = data["network"]
            self.interface = data["interface"]

    def set_latency(self, value: float | None) -> None:
        with self.lock:
            self.latency = value

    def start_metric(self, name: str) -> None:
        with self.lock:
            self.phase = name
            getattr(self, name).status = "testing"

    def update_metric(
        self,
        name: str,
        current: float,
        average: float,
        peak: float,
        progress: float,
        transferred: int,
        elapsed: float,
    ) -> None:
        with self.lock:
            metric = getattr(self, name)
            metric.current_mbps = current
            metric.average_mbps = average
            metric.peak_mbps = peak
            metric.progress = progress
            metric.transferred = transferred
            metric.elapsed = elapsed
            metric.samples.append(current)

    def finish_metric(self, name: str, error: str = "") -> None:
        with self.lock:
            metric = getattr(self, name)
            metric.progress = 1.0
            metric.error = error
            metric.status = "error" if error else "complete"

    def finish(self) -> None:
        with self.lock:
            self.phase = "done"
        self.done.set()

    def cancel(self) -> None:
        self.cancelled = True
        self.stop.set()


def transfer_tracker(state: TestState, name: str):
    started = time.monotonic()
    history: deque[tuple[float, int]] = deque([(started, 0)])
    transferred = 0
    peak = 0.0
    last_update = 0.0

    def record(size: int, force: bool = False) -> None:
        nonlocal transferred, peak, last_update
        transferred += size
        now = time.monotonic()
        history.append((now, transferred))
        while len(history) > 1 and now - history[0][0] > 1.0:
            history.popleft()
        if not force and now - last_update < REFRESH_INTERVAL:
            return
        elapsed = max(now - started, 0.001)
        window = max(now - history[0][0], 0.001)
        current = (transferred - history[0][1]) * 8 / window / 1_000_000
        average = transferred * 8 / elapsed / 1_000_000
        peak = max(peak, current)
        state.update_metric(
            name,
            current,
            average,
            peak,
            min(elapsed / state.duration, 1.0),
            transferred,
            elapsed,
        )
        last_update = now

    return started, record


def upload_test(state: TestState) -> None:
    state.start_metric("upload")
    started, record = transfer_tracker(state, "upload")
    deadline = started + state.duration
    parsed = urllib.parse.urlsplit(UPLOAD_URL)
    error = ""

    try:
        while time.monotonic() < deadline and not state.stop.is_set():
            connection = http.client.HTTPSConnection(parsed.hostname, parsed.port, timeout=3)
            path = parsed.path or "/"
            if parsed.query:
                path += "?" + parsed.query
            connection.putrequest("POST", path)
            connection.putheader("User-Agent", USER_AGENT)
            connection.putheader("Cache-Control", "no-cache")
            connection.putheader("Content-Type", "application/octet-stream")
            connection.putheader("Content-Length", str(UPLOAD_BATCH))
            connection.endheaders()
            sent = 0
            chunk = bytes(CHUNK_SIZE)
            try:
                while sent < UPLOAD_BATCH and time.monotonic() < deadline and not state.stop.is_set():
                    size = min(CHUNK_SIZE, UPLOAD_BATCH - sent)
                    connection.send(chunk[:size])
                    sent += size
                    record(size)
                if sent == UPLOAD_BATCH:
                    response = connection.getresponse()
                    response.read()
                    if response.status < 200 or response.status >= 300:
                        raise OSError(f"HTTP {response.status}")
            finally:
                connection.close()
        record(0, force=True)
    except (OSError, http.client.HTTPException, socket.timeout) as exc:
        error = str(exc)

    if not state.stop.is_set():
        state.finish_metric("upload", error)


def download_test(state: TestState) -> None:
    state.start_metric("download")
    started, record = transfer_tracker(state, "download")
    deadline = started + state.duration
    error = ""
    headers = {"User-Agent": USER_AGENT, "Cache-Control": "no-cache"}

    try:
        while time.monotonic() < deadline and not state.stop.is_set():
            request = urllib.request.Request(DOWNLOAD_URL, headers=headers)
            with urllib.request.urlopen(request, timeout=5) as response:
                while time.monotonic() < deadline and not state.stop.is_set():
                    chunk = response.read(CHUNK_SIZE)
                    if not chunk:
                        break
                    record(len(chunk))
        record(0, force=True)
    except (OSError, urllib.error.URLError, TimeoutError) as exc:
        error = str(exc)

    if not state.stop.is_set():
        state.finish_metric("download", error)


def test_worker(state: TestState) -> None:
    try:
        state.set_connection(connection_info())
        state.set_latency(latency_ms())
        if state.stop.is_set():
            return
        upload_test(state)
        if state.stop.is_set():
            return
        download_test(state)
    except Exception as exc:
        state.fatal_error = str(exc)
    finally:
        state.finish()


def paint(text: str, name: str, enabled: bool, bold: bool = False) -> str:
    if not enabled:
        return text
    red, green, blue = PALETTE[name]
    weight = "1;" if bold else ""
    return f"\x1b[{weight}38;2;{red};{green};{blue}m{text}\x1b[0m"


def metric_value(value: float, ready: bool) -> tuple[str, str]:
    if not ready:
        return "- Mbps", "- MB/s"
    return f"{value:7.1f} Mbps", f"{value / 8:6.2f} MB/s"


def sparkline(values: list[float], width: int) -> str:
    if width <= 0:
        return ""
    data = values[-width:]
    if not data:
        return " " * width
    peak = max(data)
    if peak <= 0:
        return GRAPH_BLOCKS[0] * len(data) + " " * (width - len(data))
    graph = "".join(GRAPH_BLOCKS[min(int(value / peak * 7), 7)] for value in data)
    return graph.rjust(width)


def progress_bar(progress: float, width: int) -> str:
    width = max(width, 1)
    filled = min(int(progress * width), width)
    return "━" * filled + "─" * (width - filled)


def metric_lines(
    label: str,
    icon: str,
    metric: Metric,
    active: bool,
    width: int,
    color_enabled: bool,
) -> list[str]:
    status = {
        "waiting": "WAITING",
        "testing": f"TESTING {metric.progress * 100:3.0f}%",
        "complete": "COMPLETE",
        "error": "ERROR",
    }.get(metric.status, metric.status.upper())
    tone = "accent" if active else "dim"
    ready = metric.status in {"testing", "complete", "error"} and metric.transferred > 0
    speed = metric.current_mbps if active else metric.average_mbps
    primary, secondary = metric_value(speed, ready)
    heading = f"{icon}  {label:<8} {status}"
    values = f"   {primary}    {secondary}"
    if ready:
        values += f"    peak {metric.peak_mbps:.1f} Mbps"
    graph_width = max(18, width - 3)
    graph = "   " + sparkline(list(metric.samples), graph_width)
    bar = "   " + progress_bar(metric.progress, graph_width)
    if metric.error:
        detail = "   " + metric.error[: max(width - 3, 1)]
        return [
            paint(heading, "error", color_enabled, True),
            paint(values, "text", color_enabled, True),
            paint(graph, tone, color_enabled),
            paint(detail, "error", color_enabled),
        ]
    return [
        paint(heading, tone, color_enabled, True),
        paint(values, "text", color_enabled, True),
        paint(graph, tone, color_enabled),
        paint(bar, tone, color_enabled),
    ]


def copy_metric(metric: Metric) -> Metric:
    return Metric(
        status=metric.status,
        current_mbps=metric.current_mbps,
        average_mbps=metric.average_mbps,
        peak_mbps=metric.peak_mbps,
        progress=metric.progress,
        transferred=metric.transferred,
        elapsed=metric.elapsed,
        samples=deque(metric.samples, maxlen=240),
        error=metric.error,
    )


def snapshot(state: TestState) -> dict[str, object]:
    with state.lock:
        return {
            "phase": state.phase,
            "network": state.network,
            "interface": state.interface,
            "latency": state.latency,
            "upload": copy_metric(state.upload),
            "download": copy_metric(state.download),
            "fatal_error": state.fatal_error,
        }


def render(state: TestState, color_enabled: bool) -> list[str]:
    data = snapshot(state)
    terminal_width = shutil.get_terminal_size((80, 24)).columns
    width = min(max(terminal_width - 4, 44), 86)
    phase = str(data["phase"])
    identity = f"{data['network']} · {data['interface']}"[: max(width - 3, 1)]
    latency = data["latency"]
    latency_label = f"{latency:.1f} ms" if isinstance(latency, (int, float)) else "- ms"

    lines = [
        paint(identity, "muted", color_enabled),
        paint("─" * width, "secondary", color_enabled),
    ]
    lines.extend(metric_lines("UPLOAD", "↑", data["upload"], phase == "upload", width, color_enabled))
    lines.append("")
    lines.extend(metric_lines("DOWNLOAD", "↓", data["download"], phase == "download", width, color_enabled))
    lines.append("")

    footer = f"LATENCY  {latency_label}    q / esc quit"
    if phase == "preparing":
        footer = "LATENCY  measuring    q / esc quit"
    elif phase == "done":
        footer = f"LATENCY  {latency_label}    test complete"
    if data["fatal_error"]:
        footer = "ERROR  " + str(data["fatal_error"])
    lines.append(paint(footer[:width], "muted", color_enabled))
    return lines


class TerminalSession:
    def __init__(self, enabled: bool) -> None:
        self.enabled = enabled
        self.original: list[object] | None = None

    def __enter__(self) -> TerminalSession:
        if self.enabled:
            self.original = termios.tcgetattr(sys.stdin.fileno())
            tty.setcbreak(sys.stdin.fileno())
            sys.stdout.write("\x1b[?1049h\x1b[?25l")
            sys.stdout.flush()
        return self

    def key(self) -> str:
        if not self.enabled:
            return ""
        readable, _, _ = select.select([sys.stdin], [], [], 0)
        return sys.stdin.read(1) if readable else ""

    def draw(self, lines: list[str]) -> None:
        if not self.enabled:
            return
        sys.stdout.write("\x1b[H")
        for line in lines:
            sys.stdout.write("\x1b[2K" + line + "\n")
        sys.stdout.write("\x1b[J")
        sys.stdout.flush()

    def __exit__(self, *_: object) -> None:
        if self.enabled:
            if self.original is not None:
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self.original)
            sys.stdout.write("\x1b[?25h\x1b[?1049l")
            sys.stdout.flush()


def result_dict(state: TestState) -> dict[str, object]:
    data = snapshot(state)
    upload = data["upload"]
    download = data["download"]
    errors = [metric.error for metric in (upload, download) if metric.error]
    if data["fatal_error"]:
        errors.append(str(data["fatal_error"]))
    result: dict[str, object] = {
        "interface": data["interface"],
        "network": data["network"],
        "latency": data["latency"],
        "upload": round(upload.average_mbps, 1) if upload.transferred else None,
        "uploadMBs": round(upload.average_mbps / 8, 2) if upload.transferred else None,
        "download": round(download.average_mbps, 1) if download.transferred else None,
        "downloadMBs": round(download.average_mbps / 8, 2) if download.transferred else None,
    }
    if errors:
        result["error"] = "; ".join(errors)
    return result


def print_summary(result: dict[str, object], color_enabled: bool) -> None:
    def value(name: str, suffix: str, digits: int = 1) -> str:
        raw = result.get(name)
        return f"{raw:.{digits}f} {suffix}" if isinstance(raw, (int, float)) else "Unavailable"

    print(paint(f"{result['network']} · {result['interface']}", "muted", color_enabled))
    print()
    print(f"↑  Upload    {value('upload', 'Mbps')}    {value('uploadMBs', 'MB/s', 2)}")
    print(f"↓  Download  {value('download', 'Mbps')}    {value('downloadMBs', 'MB/s', 2)}")
    print(f"   Latency   {value('latency', 'ms')}")
    if result.get("error"):
        print(paint(f"Error: {result['error']}", "error", color_enabled), file=sys.stderr)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Measure upload first, then download, with a live terminal display.",
    )
    parser.add_argument(
        "--duration",
        type=float,
        default=DEFAULT_DURATION,
        metavar="SECONDS",
        help=f"seconds per transfer phase (default: {DEFAULT_DURATION:g})",
    )
    parser.add_argument("--json", action="store_true", help="print machine-readable JSON")
    parser.add_argument("--cli", action="store_true", help="print only the final text result")
    parser.add_argument("--no-color", action="store_true", help="disable terminal colors")
    args = parser.parse_args()
    if not 1 <= args.duration <= 30:
        parser.error("--duration must be between 1 and 30 seconds")
    return args


def main() -> int:
    mark_process()
    args = parse_args()
    interactive = sys.stdin.isatty() and sys.stdout.isatty() and not (args.json or args.cli)
    color_enabled = sys.stdout.isatty() and not args.no_color and "NO_COLOR" not in os.environ
    state = TestState(args.duration)
    worker = threading.Thread(target=test_worker, args=(state,), daemon=True)
    worker.start()

    if interactive:
        with TerminalSession(True) as terminal:
            while not state.done.is_set():
                terminal.draw(render(state, color_enabled))
                key = terminal.key()
                if key in {"q", "Q", "\x1b", "\x03"}:
                    state.cancel()
                    break
                time.sleep(REFRESH_INTERVAL)
            if not state.cancelled:
                terminal.draw(render(state, color_enabled))
                time.sleep(0.35)
    else:
        while not state.done.wait(REFRESH_INTERVAL):
            pass

    worker.join(timeout=4)
    if state.cancelled:
        return 130

    result = result_dict(state)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    else:
        print_summary(result, color_enabled)
    return 1 if result.get("error") else 0


if __name__ == "__main__":
    raise SystemExit(main())
