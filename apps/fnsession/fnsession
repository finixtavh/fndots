#!/usr/bin/env python3

from __future__ import annotations

import argparse
import fcntl
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path
from typing import Any

FORMAT = "fnsession"

HOME = Path.home()

def absolute_xdg_dir(variable: str, fallback: Path) -> Path:

    configured = os.environ.get(variable, "")
    candidate = Path(configured) if configured else fallback
    return candidate if candidate.is_absolute() else fallback

STATE_HOME = absolute_xdg_dir("XDG_STATE_HOME", HOME / ".local/state")
SESSION_DIR = STATE_HOME / "fnsession" / "sessions"
HYPRCTL = os.environ.get("FNSESSION_HYPRCTL", "hyprctl")
POLL_INTERVAL = 0.15
IGNORED_CLASSES = {"fnsession"}
CHILD_PROCESS_MARKERS = (
    "--type=renderer",
    "--type=gpu-process",
    "--type=utility",
    "--type=zygote",
    "-contentproc",
)

def bounded_env_float(variable: str, default: float, minimum: float, maximum: float) -> float:

    try:
        value = float(os.environ.get(variable, str(default)))
    except ValueError:
        return default
    return value if math.isfinite(value) and minimum <= value <= maximum else default

def bounded_env_int(variable: str, default: int, minimum: int, maximum: int) -> int:
    try:
        value = int(os.environ.get(variable, str(default)))
    except ValueError:
        return default
    return value if minimum <= value <= maximum else default

RESTORE_TIMEOUT = bounded_env_float("FNSESSION_TIMEOUT", 12.0, 1.0, 120.0)
HYPRCTL_TIMEOUT = bounded_env_float("FNSESSION_HYPRCTL_TIMEOUT", 3.0, 0.5, 30.0)
STARTUP_SETTLE = bounded_env_float("FNSESSION_STARTUP_SETTLE", 0.8, 0.1, 10.0)
GEOMETRY_TOLERANCE = bounded_env_int("FNSESSION_GEOMETRY_TOLERANCE", 8, 0, 1000)
WATCH_INTERVAL = bounded_env_float("FNSESSION_WATCH_INTERVAL", 2.0, 0.5, 3600.0)
EMPTY_STABLE_SECONDS = bounded_env_float("FNSESSION_EMPTY_STABLE", 8.0, 1.0, 300.0)
CAPTURE_PROCESS_CONTEXT = os.environ.get("FNSESSION_CAPTURE_CONTEXT") == "1"
INTERPRETER_NAMES = {
    "bash", "dash", "fish", "gjs", "node", "perl", "python", "python3", "ruby", "sh", "zsh",
}
RUNTIME_WRAPPER_NAMES = INTERPRETER_NAMES | {
    "bwrap", "pressure-vessel-wrap", "steamwebhelper", "wine", "wine64", "xdg-dbus-proxy",
}
MAX_SESSION_BYTES = 8 * 1024 * 1024

class FnSessionError(RuntimeError):
    pass

def hyprctl(*args: str, json_output: bool = False) -> Any:
    try:
        result = subprocess.run(
            [HYPRCTL, *args],
            check=True,
            capture_output=True,
            text=True,
            timeout=HYPRCTL_TIMEOUT,
        )
    except FileNotFoundError as error:
        raise FnSessionError(f"{HYPRCTL!r} was not found") from error
    except subprocess.CalledProcessError as error:
        detail = (error.stderr or error.stdout or "unknown Hyprland error").strip()
        raise FnSessionError(f"hyprctl {' '.join(args)} failed: {detail}") from error
    except subprocess.TimeoutExpired as error:
        raise FnSessionError(
            f"hyprctl {' '.join(args)} timed out after {HYPRCTL_TIMEOUT:g}s"
        ) from error

    if not json_output:
        return result.stdout.strip()
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise FnSessionError("Hyprland returned invalid JSON") from error

def clients() -> list[dict[str, Any]]:
    value = hyprctl("-j", "clients", json_output=True)
    if not isinstance(value, list):
        raise FnSessionError("Hyprland returned an unexpected clients payload")
    return [client for client in value if isinstance(client, dict)]

def active_workspace() -> str:
    value = hyprctl("-j", "activeworkspace", json_output=True)
    if not isinstance(value, dict):
        return ""
    return str(value.get("name") or value.get("id") or "")

def workspace_layouts() -> dict[str, str]:
    value = hyprctl("-j", "workspaces", json_output=True)
    if not isinstance(value, list):
        return {}
    result: dict[str, str] = {}
    for item in value:
        if not isinstance(item, dict):
            continue
        name = str(item.get("name") or item.get("id") or "")
        layout = str(item.get("tiledLayout") or item.get("tiled_layout") or "")
        if name and layout:
            result[name] = layout
    return result

def current_general_layout() -> str:
    try:
        value = hyprctl("repl", 'hl.get_config("general.layout")')
    except FnSessionError:
        return ""
    return str(value).strip().strip('"').strip("'")

def safe_name(name: str) -> str:
    cleaned = re.sub(r"[^\w._ -]+", "_", name.strip())
    cleaned = re.sub(r"\s+", " ", cleaned).strip(" .")
    if not cleaned or not any(character.isalnum() for character in cleaned):
        raise FnSessionError("session name must contain a letter or number")
    return cleaned

def path_for_name(name: str) -> Path:
    return SESSION_DIR / f"{safe_name(name)}.json"

def latest_session() -> Path:
    try:
        files = [
            path for path in SESSION_DIR.glob("*.json")
            if path.is_file() and not path.is_symlink()
        ]
    except OSError as error:
        raise FnSessionError(f"could not read {SESSION_DIR}: {error}") from error
    if not files:
        raise FnSessionError(f"no saved sessions in {SESSION_DIR}")
    return max(files, key=lambda path: path.stat().st_mtime_ns)

def list_sessions(json_output: bool = False) -> int:

    try:
        files = sorted(
            (path for path in SESSION_DIR.glob("*.json") if path.is_file() and not path.is_symlink()),
            key=lambda path: path.stat().st_mtime_ns,
            reverse=True,
        )
    except OSError as error:
        raise FnSessionError(f"could not read {SESSION_DIR}: {error}") from error
    rows = [
        {
            "name": path.stem,
            "modified": int(path.stat().st_mtime),
        }
        for path in files
    ]
    if json_output:
        print(json.dumps(rows, ensure_ascii=False, separators=(",", ":")))
    else:
        for row in rows:
            print(row["name"])
    return 0

def class_command(initial_class: str, window_class: str) -> list[str]:

    candidates: list[str] = []
    for value in (initial_class, window_class):
        value = value.strip()
        if not value:
            continue
        candidates.extend((value, value.lower(), Path(value).name, Path(value).name.lower()))
    for candidate in dict.fromkeys(candidates):
        executable = shutil.which(candidate)
        if executable:
            return [executable]
    return []

def host_relaunchable(executable: str) -> bool:
    path = Path(executable)
    name = path.name.lower()
    return (
        path.is_absolute()
        and path.is_file()
        and os.access(path, os.X_OK)
        and name not in RUNTIME_WRAPPER_NAMES
        and not name.startswith("electron")
    )

def minimal_launch_command(
    argv: Any, initial_class: str, window_class: str
) -> list[str]:
    if (
        isinstance(argv, list)
        and argv
        and all(isinstance(item, str) for item in argv)
        and host_relaunchable(argv[0])
    ):
        return [argv[0]]
    return class_command(initial_class, window_class)

def process_command(pid: Any, initial_class: str, window_class: str) -> list[str]:

    try:
        numeric_pid = int(pid)
        raw = Path(f"/proc/{numeric_pid}/cmdline").read_bytes()
        argv = [
            item.decode("utf-8", errors="surrogateescape")
            for item in raw.split(b"\0")
            if item
        ]
        if argv:
            if not CAPTURE_PROCESS_CONTEXT:
                return minimal_launch_command(argv, initial_class, window_class)

            joined = "\0".join(argv)
            if any(marker in joined for marker in CHILD_PROCESS_MARKERS):
                resolved = class_command(initial_class, window_class)
                if resolved:
                    return resolved
                executable = argv[0]
                if Path(executable).is_file() and os.access(executable, os.X_OK):
                    return [executable]
            return argv
    except (OSError, TypeError, ValueError):
        pass

    return class_command(initial_class, window_class)

def process_cwd(pid: Any) -> str:
    if not CAPTURE_PROCESS_CONTEXT:
        return ""
    try:
        return os.readlink(f"/proc/{int(pid)}/cwd")
    except (OSError, TypeError, ValueError):
        return ""

def valid_pair(value: Any) -> list[int] | None:
    if (
        isinstance(value, list)
        and len(value) == 2
        and all(
            isinstance(item, (int, float))
            and not isinstance(item, bool)
            and math.isfinite(item)
            and abs(item) <= 10_000_000
            for item in value
        )
    ):
        return [int(value[0]), int(value[1])]
    return None

def bounded_int(value: Any, default: int, minimum: int, maximum: int) -> int:
    if isinstance(value, bool):
        return default
    try:
        parsed = int(value)
    except (TypeError, ValueError, OverflowError):
        return default
    return parsed if minimum <= parsed <= maximum else default

def workspace_name(client: dict[str, Any]) -> str:
    workspace = client.get("workspace")
    if not isinstance(workspace, dict):
        return ""
    return str(workspace.get("name") or workspace.get("id") or "")

def capture_window(client: dict[str, Any], order: int) -> dict[str, Any] | None:
    if not client.get("mapped", True):
        return None

    window_class = str(client.get("class") or "")
    initial_class = str(client.get("initialClass") or window_class)
    if (
        window_class.lower() in IGNORED_CLASSES
        or initial_class.lower() in IGNORED_CLASSES
    ):
        return None

    position = valid_pair(client.get("at"))
    size = valid_pair(client.get("size"))
    workspace = workspace_name(client)
    if not position or not size or not workspace:
        return None

    fullscreen = client.get("fullscreen", 0)
    try:
        fullscreen = int(fullscreen)
    except (TypeError, ValueError):
        fullscreen = 1 if fullscreen else 0

    captured = {
        "order": order,
        "class": window_class,
        "initial_class": initial_class,
        "title": str(client.get("title") or ""),
        "initial_title": str(client.get("initialTitle") or ""),
        "workspace": workspace,
        "monitor": bounded_int(client.get("monitor", -1), -1, -1, 1024),
        "at": position,
        "size": size,
        "was_floating": bool(client.get("floating", False)),
        "was_pseudo": bool(client.get("pseudo", False)),
        "was_pinned": bool(client.get("pinned", False)),
        "fullscreen": fullscreen,
        "xwayland": bool(client.get("xwayland", False)),
        "modal": bool(client.get("modal", False)),
        "command": process_command(client.get("pid"), initial_class, window_class),
    }
    if CAPTURE_PROCESS_CONTEXT:
        captured["cwd"] = process_cwd(client.get("pid"))
    return captured

def _window_rect(window: dict[str, Any]) -> tuple[float, float, float, float] | None:
    at = valid_pair(window.get("at"))
    size = valid_pair(window.get("size"))
    if not at or not size or size[0] <= 0 or size[1] <= 0:
        return None
    return (float(at[0]), float(at[1]), float(at[0] + size[0]), float(at[1] + size[1]))

def _bbox(items: list[dict[str, Any]]) -> tuple[float, float, float, float]:
    rects = [_window_rect(item) for item in items]
    valid = [rect for rect in rects if rect is not None]
    if not valid:
        raise FnSessionError("cannot infer tiled layout from invalid geometry")
    return (
        min(rect[0] for rect in valid),
        min(rect[1] for rect in valid),
        max(rect[2] for rect in valid),
        max(rect[3] for rect in valid),
    )

def _split_candidate(
    items: list[dict[str, Any]],
    axis: str,
    tolerance: float,
) -> tuple[float, list[dict[str, Any]], list[dict[str, Any]], float] | None:
    if len(items) < 2:
        return None

    rects = {int(item["order"]): _window_rect(item) for item in items}
    if any(rect is None for rect in rects.values()):
        return None

    if axis == "x":
        ordered = sorted(items, key=lambda item: ((rects[int(item["order"])][0] + rects[int(item["order"])][2]) / 2, int(item["order"])))
    else:
        ordered = sorted(items, key=lambda item: ((rects[int(item["order"])][1] + rects[int(item["order"])][3]) / 2, int(item["order"])))

    parent = _bbox(items)
    best: tuple[float, list[dict[str, Any]], list[dict[str, Any]], float] | None = None

    for cut in range(1, len(ordered)):
        first = ordered[:cut]
        second = ordered[cut:]
        a = _bbox(first)
        b = _bbox(second)

        if axis == "x":
            overlap = a[2] - b[0]
            if overlap > tolerance:
                continue

            orth_penalty = abs(a[1] - parent[1]) + abs(a[3] - parent[3]) \
                + abs(b[1] - parent[1]) + abs(b[3] - parent[3])
            gap = max(0.0, b[0] - a[2])
            first_span = max(1.0, a[2] - a[0])
            second_span = max(1.0, b[2] - b[0])
        else:
            overlap = a[3] - b[1]
            if overlap > tolerance:
                continue
            orth_penalty = abs(a[0] - parent[0]) + abs(a[2] - parent[2]) \
                + abs(b[0] - parent[0]) + abs(b[2] - parent[2])
            gap = max(0.0, b[1] - a[3])
            first_span = max(1.0, a[3] - a[1])
            second_span = max(1.0, b[3] - b[1])

        total = first_span + gap + second_span
        fraction = (first_span + gap / 2.0) / max(1.0, total)

        splitratio = min(1.9, max(0.1, 2.0 * fraction))

        score = max(0.0, overlap) * 10_000.0 + orth_penalty
        candidate = (score, first, second, splitratio)
        if best is None or candidate[0] < best[0]:
            best = candidate

    return best

def infer_dwindle_tree(items: list[dict[str, Any]]) -> dict[str, Any] | None:
    tiled = [
        item for item in items
        if not bool(item.get("was_floating", False))
        and bounded_int(item.get("fullscreen", 0), 0, 0, 2) == 0
    ]
    if not tiled:
        return None
    if len(tiled) == 1:
        return {"type": "leaf", "order": int(tiled[0]["order"])}

    tolerance = max(2.0, float(GEOMETRY_TOLERANCE) * 2.0)

    def build(group: list[dict[str, Any]]) -> dict[str, Any] | None:
        if len(group) == 1:
            return {"type": "leaf", "order": int(group[0]["order"])}

        candidates: list[tuple[float, str, list[dict[str, Any]], list[dict[str, Any]], float]] = []
        for axis in ("x", "y"):
            candidate = _split_candidate(group, axis, tolerance)
            if candidate is None:
                continue
            score, first, second, ratio = candidate
            candidates.append((score, axis, first, second, ratio))

        candidates.sort(key=lambda value: (value[0], value[1]))
        for _score, axis, first, second, ratio in candidates:
            first_tree = build(first)
            if first_tree is None:
                continue
            second_tree = build(second)
            if second_tree is None:
                continue
            return {
                "type": "split",
                "axis": axis,
                "ratio": round(ratio, 6),
                "first": first_tree,
                "second": second_tree,
            }
        return None

    return build(tiled)

def capture_dwindle_trees(
    windows: list[dict[str, Any]],
    layouts: dict[str, str],
) -> dict[str, Any]:
    by_workspace: dict[str, list[dict[str, Any]]] = {}
    for window in windows:
        if bool(window.get("was_floating", False)):
            continue
        workspace = str(window.get("workspace") or "")
        if workspace:
            by_workspace.setdefault(workspace, []).append(window)

    trees: dict[str, Any] = {}
    for workspace, items in by_workspace.items():
        if layouts.get(workspace) != "dwindle":
            continue
        if any(bounded_int(item.get("fullscreen", 0), 0, 0, 2) != 0 for item in items):
            continue
        tree = infer_dwindle_tree(items)
        if tree is not None:
            trees[workspace] = tree
    return trees

def _tree_orders(tree: Any) -> list[int]:
    if not isinstance(tree, dict):
        return []
    if tree.get("type") == "leaf":
        order = tree.get("order")
        return [order] if isinstance(order, int) and not isinstance(order, bool) else []
    if tree.get("type") != "split":
        return []
    return _tree_orders(tree.get("first")) + _tree_orders(tree.get("second"))

def _tree_representative(tree: dict[str, Any]) -> int:
    if tree.get("type") == "leaf":
        return int(tree["order"])
    return _tree_representative(tree["first"])

def _valid_dwindle_tree(tree: Any, known_orders: set[int]) -> bool:
    orders = _tree_orders(tree)
    if not orders or len(orders) != len(set(orders)):
        return False
    if any(order not in known_orders for order in orders):
        return False

    def check(node: Any) -> bool:
        if not isinstance(node, dict):
            return False
        if node.get("type") == "leaf":
            order = node.get("order")
            return isinstance(order, int) and not isinstance(order, bool)
        if node.get("type") != "split" or node.get("axis") not in {"x", "y"}:
            return False
        ratio = node.get("ratio")
        if not isinstance(ratio, (int, float)) or isinstance(ratio, bool) or not math.isfinite(ratio):
            return False
        if not 0.1 <= float(ratio) <= 1.9:
            return False
        return check(node.get("first")) and check(node.get("second"))

    return check(tree)

def atomic_json_write(path: Path, value: dict[str, Any]) -> None:
    if SESSION_DIR.parent == STATE_HOME / "fnsession":
        SESSION_DIR.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(SESSION_DIR.parent, 0o700)
    SESSION_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(SESSION_DIR, 0o700)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.",
        dir=SESSION_DIR,
        text=True,
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)

def session_payload(session_name: str) -> dict[str, Any]:
    windows = [
        captured
        for index, client in enumerate(clients())
        if (captured := capture_window(client, index)) is not None
    ]
    layouts = workspace_layouts()
    return {
        "format": FORMAT,
        "name": session_name,
        "saved_at": datetime.now().astimezone().isoformat(timespec="seconds"),
        "active_workspace": active_workspace(),
        "workspace_layouts": layouts,
        "dwindle_trees": capture_dwindle_trees(windows, layouts),
        "windows": windows,
    }

def save_session(
    name: str | None,
    *,
    quiet: bool = False,
    refuse_empty_overwrite: bool = False,
) -> int:
    session_name = name or datetime.now().astimezone().strftime("%Y-%m-%d_%H-%M-%S")
    path = path_for_name(session_name)
    payload = session_payload(session_name)

    if refuse_empty_overwrite and not payload["windows"] and path.is_file():
        try:
            old = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(old, dict) and old.get("windows"):
                return 0
        except (OSError, json.JSONDecodeError):
            pass

    atomic_json_write(path, payload)
    missing = sum(not window["command"] for window in payload["windows"])
    if not quiet:
        print(f"Saved {len(payload['windows'])} window(s) to {path}")
    if missing and not quiet:
        print(
            f"Warning: {missing} window(s) had no reusable launch command.",
            file=sys.stderr,
        )
    return 0

def payload_fingerprint(payload: dict[str, Any]) -> str:
    windows: list[dict[str, Any]] = []
    for item in payload.get("windows", []):
        if not isinstance(item, dict):
            continue
        canonical = dict(item)

        canonical.pop("order", None)
        windows.append(canonical)
    windows.sort(
        key=lambda item: (
            str(item.get("workspace") or ""),
            normalized(item.get("initial_class")),
            normalized(item.get("title")),
            tuple(valid_pair(item.get("at")) or []),
        )
    )
    stable = {
        "active_workspace": payload.get("active_workspace"),
        "workspace_layouts": payload.get("workspace_layouts", {}),
        "dwindle_trees": payload.get("dwindle_trees", {}),
        "windows": windows,
    }
    return json.dumps(stable, sort_keys=True, ensure_ascii=False, separators=(",", ":"))

def watch_session(name: str, interval: float) -> int:

    if not math.isfinite(interval) or not 0.5 <= interval <= 3600:
        raise FnSessionError("watch interval must be between 0.5 and 3600 seconds")
    stop = False

    def request_stop(_signum: int, _frame: Any) -> None:
        nonlocal stop
        stop = True

    signal.signal(signal.SIGINT, request_stop)
    signal.signal(signal.SIGTERM, request_stop)

    session_name = safe_name(name)
    path = path_for_name(session_name)
    if SESSION_DIR.parent == STATE_HOME / "fnsession":
        SESSION_DIR.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(SESSION_DIR.parent, 0o700)
    SESSION_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(SESSION_DIR, 0o700)
    lock_path = SESSION_DIR / f".{session_name}.watch.lock"
    lock_handle = lock_path.open("w", encoding="utf-8")
    os.chmod(lock_path, 0o600)
    try:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        lock_handle.close()
        raise FnSessionError(f"a watcher for session {session_name!r} is already running") from error
    lock_handle.write(f"{os.getpid()}\n")
    lock_handle.flush()

    previous = ""
    try:
        if path.is_file():
            existing = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(existing, dict):
                previous = payload_fingerprint(existing)
    except (OSError, json.JSONDecodeError):
        pass

    empty_since: float | None = None
    try:
        while not stop:
            try:
                payload = session_payload(session_name)
                fingerprint = payload_fingerprint(payload)
                now = time.monotonic()
                if payload["windows"]:
                    empty_since = None
                elif empty_since is None:
                    empty_since = now

                if fingerprint != previous:

                    empty_is_stable = (
                        empty_since is not None
                        and now - empty_since >= EMPTY_STABLE_SECONDS
                    )
                    if payload["windows"] or empty_is_stable:
                        atomic_json_write(path, payload)
                        previous = fingerprint
            except FnSessionError:

                pass
            time.sleep(interval)
    finally:
        lock_handle.close()
        lock_path.unlink(missing_ok=True)
    return 0

def read_session(name: str | None) -> tuple[Path, dict[str, Any]]:
    path = path_for_name(name) if name else latest_session()
    if not path.is_file() or path.is_symlink():
        available = (
            ", ".join(item.stem for item in sorted(SESSION_DIR.glob("*.json")))
            or "none"
        )
        raise FnSessionError(f"session {name!r} was not found (available: {available})")
    try:
        if path.stat().st_size > MAX_SESSION_BYTES:
            limit_mib = MAX_SESSION_BYTES // (1024 * 1024)
            raise FnSessionError(f"{path} exceeds the {limit_mib} MiB limit")
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise FnSessionError(f"could not read {path}: {error}") from error
    if (
        not isinstance(payload, dict)
        or payload.get("format") != FORMAT
        or not isinstance(payload.get("windows"), list)
    ):
        raise FnSessionError(
            f"{path} is not a supported fnsession file "
        )
    for index, window in enumerate(payload["windows"]):
        if not isinstance(window, dict):
            raise FnSessionError(f"{path} has an invalid window at index {index}")
        order = window.get("order", index)
        command = window.get("command", [])
        if not isinstance(order, int) or isinstance(order, bool):
            raise FnSessionError(f"{path} has an invalid window order at index {index}")
        if not isinstance(command, list) or not all(isinstance(arg, str) for arg in command):
            raise FnSessionError(f"{path} has an invalid launch command at index {index}")
        if len(command) > 128 or any(not arg or len(arg) > 16_384 for arg in command):
            raise FnSessionError(f"{path} has an excessive launch command at index {index}")
        if valid_pair(window.get("at")) is None or valid_pair(window.get("size")) is None:
            raise FnSessionError(f"{path} has invalid geometry at index {index}")
        if not isinstance(window.get("workspace"), (str, int)):
            raise FnSessionError(f"{path} has an invalid workspace at index {index}")
        if not CAPTURE_PROCESS_CONTEXT:
            window["command"] = minimal_launch_command(
                command,
                str(window.get("initial_class") or ""),
                str(window.get("class") or ""),
            )
            window.pop("cwd", None)

    return path, payload

def normalized(value: Any) -> str:
    return str(value or "").strip().casefold()

def identity_score(saved: dict[str, Any], current: dict[str, Any]) -> int | None:
    saved_initial = normalized(saved.get("initial_class"))
    current_initial = normalized(current.get("initialClass"))
    saved_class = normalized(saved.get("class"))
    current_class = normalized(current.get("class"))
    saved_classes = {value for value in (saved_initial, saved_class) if value}
    current_classes = {value for value in (current_initial, current_class) if value}
    if not saved_classes.intersection(current_classes):
        return None

    saved_title = normalized(saved.get("title"))
    current_title = normalized(current.get("title"))
    if saved_title and saved_title == current_title:
        return 0

    saved_initial_title = normalized(saved.get("initial_title"))
    current_initial_title = normalized(current.get("initialTitle"))
    if saved_initial_title and saved_initial_title == current_initial_title:
        return 1

    if saved_initial and saved_initial == current_initial:
        return 2
    return 3

def numeric_pair_distance(left: Any, right: Any) -> int:
    a = valid_pair(left)
    b = valid_pair(right)
    if not a or not b:
        return 100_000
    return abs(a[0] - b[0]) + abs(a[1] - b[1])

def candidate_key(saved: dict[str, Any], current: dict[str, Any]) -> tuple[int, ...] | None:
    identity = identity_score(saved, current)
    if identity is None:
        return None
    floating_penalty = 0 if bool(saved.get("was_floating", False)) == bool(current.get("floating", False)) else 1
    modal_penalty = 0 if bool(saved.get("modal", False)) == bool(current.get("modal", False)) else 1
    xwayland_penalty = 0 if bool(saved.get("xwayland", False)) == bool(current.get("xwayland", False)) else 1
    workspace_penalty = 0 if workspace_name(current) == str(saved.get("workspace") or "") else 1
    size_distance = numeric_pair_distance(saved.get("size"), current.get("size"))
    position_distance = numeric_pair_distance(saved.get("at"), current.get("at"))
    return (
        identity,
        floating_penalty,
        modal_penalty,
        xwayland_penalty,
        workspace_penalty,
        size_distance,
        position_distance,
    )

def best_match(
    saved: dict[str, Any],
    current_clients: list[dict[str, Any]],
    excluded: set[str],
) -> dict[str, Any] | None:
    candidates: list[tuple[tuple[int, ...], dict[str, Any]]] = []
    for current in current_clients:
        address = str(current.get("address") or "")
        if not address or address in excluded:
            continue
        score = candidate_key(saved, current)
        if score is not None:
            candidates.append((score, current))
    if not candidates:
        return None
    return min(candidates, key=lambda item: item[0])[1]

def reserve_exact_matches(
    saved_windows: list[dict[str, Any]],
    current_clients: list[dict[str, Any]],
) -> tuple[dict[int, dict[str, Any]], set[str]]:
    reserved: dict[int, dict[str, Any]] = {}
    used: set[str] = set()

    for target_score in (0, 1):
        for index, saved in enumerate(saved_windows):
            if index in reserved:
                continue
            candidates = [
                current
                for current in current_clients
                if str(current.get("address") or "") not in used
                and identity_score(saved, current) == target_score
            ]
            if not candidates:
                continue
            match = min(candidates, key=lambda current: candidate_key(saved, current) or (999,))
            address = str(match.get("address") or "")
            reserved[index] = match
            used.add(address)
    return reserved, used

def launch_candidate_compatible(saved: dict[str, Any], current: dict[str, Any]) -> bool:
    if bool(current.get("modal", False)) != bool(saved.get("modal", False)):
        return False
    if bool(current.get("floating", False)) == bool(saved.get("was_floating", False)):
        return True

    saved_size = valid_pair(saved.get("size"))
    current_size = valid_pair(current.get("size"))
    identity = identity_score(saved, current)
    if identity is None or identity > 1 or not saved_size or not current_size:
        return False
    width_ratio = current_size[0] / max(1, saved_size[0])
    height_ratio = current_size[1] / max(1, saved_size[1])
    return width_ratio >= 0.55 and height_ratio >= 0.55

def launch_window(
    saved: dict[str, Any], known_addresses: set[str]
) -> dict[str, Any] | None:
    command = saved.get("command")
    if (
        not isinstance(command, list)
        or not command
        or not all(isinstance(item, str) and item for item in command)
    ):
        return None
    try:
        cwd_value = saved.get("cwd")
        cwd = (
            cwd_value
            if isinstance(cwd_value, str) and Path(cwd_value).is_dir()
            else None
        )
        subprocess.Popen(
            command,
            cwd=cwd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as error:
        print(f"Warning: could not launch {command[0]}: {error}", file=sys.stderr)
        return None

    deadline = time.monotonic() + RESTORE_TIMEOUT
    stable_since = time.monotonic()
    last_signature: tuple[Any, ...] = ()
    fallback: dict[str, Any] | None = None

    while time.monotonic() < deadline:
        now = time.monotonic()
        current = clients()
        new_clients = [
            item
            for item in current
            if str(item.get("address") or "") not in known_addresses
        ]
        matching = [item for item in new_clients if identity_score(saved, item) is not None]
        matching.sort(key=lambda item: candidate_key(saved, item) or (999,))

        strong = [
            item
            for item in matching
            if identity_score(saved, item) is not None
            and identity_score(saved, item) <= 1
        ]
        strong_compatible = [
            item for item in strong if launch_candidate_compatible(saved, item)
        ]
        if strong_compatible:
            return strong_compatible[0]

        signature = tuple(
            sorted(
                (
                    str(item.get("address") or ""),
                    normalized(item.get("class")),
                    normalized(item.get("title")),
                    bool(item.get("floating", False)),
                    tuple(valid_pair(item.get("size")) or []),
                )
                for item in matching
            )
        )
        if signature != last_signature:
            last_signature = signature
            stable_since = now

        compatible = [
            item for item in matching if launch_candidate_compatible(saved, item)
        ]
        if compatible:
            fallback = compatible[0]
        elif matching:
            fallback = matching[0]

        if fallback is not None and now - stable_since >= STARTUP_SETTLE:
            if compatible:
                return fallback

        time.sleep(POLL_INTERVAL)
    return fallback

def lua_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)

def lua_workspace(value: str) -> str:
    if re.fullmatch(r"[1-9][0-9]*", value):
        return value
    return lua_string(value)

def dispatch(expression: str) -> None:
    hyprctl("dispatch", expression, "")

def pair_matches(left: Any, right: Any, tolerance: int = GEOMETRY_TOLERANCE) -> bool:
    a = valid_pair(left)
    b = valid_pair(right)
    if not a or not b:
        return False
    return abs(a[0] - b[0]) <= tolerance and abs(a[1] - b[1]) <= tolerance

def current_client(address: str) -> dict[str, Any] | None:
    return next(
        (item for item in clients() if str(item.get("address") or "") == address),
        None,
    )

def apply_geometry(saved: dict[str, Any], address: str) -> None:
    position = valid_pair(saved.get("at"))
    size = valid_pair(saved.get("size"))
    workspace = str(saved.get("workspace") or "")
    if not position or not size or not workspace:
        raise FnSessionError("session contains invalid window geometry")

    selector = lua_string(f"address:{address}")
    workspace_value = lua_workspace(workspace)
    dispatch(
        "hl.dsp.window.move({ "
        f"workspace = {workspace_value}, follow = false, window = {selector}"
        " })"
    )

    if bool(saved.get("was_floating", False)):
        dispatch(f'hl.dsp.window.float({{ action = "on", window = {selector} }})')
        dispatch(
            "hl.dsp.window.resize({ "
            f"x = {size[0]}, y = {size[1]}, relative = false, window = {selector}"
            " })"
        )
        dispatch(
            "hl.dsp.window.move({ "
            f"x = {position[0]}, y = {position[1]}, relative = false, window = {selector}"
            " })"
        )
    else:

        dispatch(f'hl.dsp.window.float({{ action = "off", window = {selector} }})')

    if bool(saved.get("was_pseudo", False)):
        dispatch(f'hl.dsp.window.pseudo({{ action = "on", window = {selector} }})')
    else:
        dispatch(f'hl.dsp.window.pseudo({{ action = "off", window = {selector} }})')

def focus_window(address: str) -> None:
    selector = lua_string(f"address:{address}")
    dispatch(f"hl.dsp.focus({{ window = {selector} }})")

def move_window_to_workspace(address: str, workspace: str) -> None:
    selector = lua_string(f"address:{address}")
    dispatch(
        "hl.dsp.window.move({ "
        f"workspace = {lua_workspace(workspace)}, follow = false, window = {selector}"
        " })"
    )

def set_window_tiled(address: str) -> None:
    selector = lua_string(f"address:{address}")
    dispatch(f'hl.dsp.window.float({{ action = "off", window = {selector} }})')

def apply_tiled_flags(saved: dict[str, Any], address: str) -> None:
    selector = lua_string(f"address:{address}")
    if bool(saved.get("was_pseudo", False)):
        dispatch(f'hl.dsp.window.pseudo({{ action = "on", window = {selector} }})')
    else:
        dispatch(f'hl.dsp.window.pseudo({{ action = "off", window = {selector} }})')

def stage_dwindle_window(address: str, staging_workspace: str) -> None:
    set_window_tiled(address)
    move_window_to_workspace(address, staging_workspace)

def restore_dwindle_tree(
    workspace: str,
    tree: dict[str, Any],
    addresses: dict[int, str],
) -> None:
    orders = _tree_orders(tree)
    if not orders:
        raise FnSessionError(f"workspace {workspace!r} has an empty dwindle tree")
    missing = [order for order in orders if not addresses.get(order)]
    if missing:
        raise FnSessionError(
            f"workspace {workspace!r} is missing restored tiled windows: {missing}"
        )

    first_order = _tree_representative(tree)
    first_address = addresses[first_order]
    move_window_to_workspace(first_address, workspace)
    set_window_tiled(first_address)
    focus_window(first_address)

    def build(node: dict[str, Any]) -> None:
        if node.get("type") == "leaf":
            return

        first = node["first"]
        second = node["second"]
        first_order = _tree_representative(first)
        second_order = _tree_representative(second)
        first_address = addresses[first_order]
        second_address = addresses[second_order]

        focus_window(first_address)
        direction = "r" if node["axis"] == "x" else "d"
        dispatch(f'hl.dsp.layout({lua_string(f"preselect {direction}")})')
        move_window_to_workspace(second_address, workspace)
        set_window_tiled(second_address)

        focus_window(first_address)
        ratio = min(1.9, max(0.1, float(node["ratio"])))
        dispatch(f'hl.dsp.layout({lua_string(f"splitratio {ratio:.6f} exact")})')

        build(first)
        build(second)

    build(tree)

def exact_tiled_geometry_matches(saved: dict[str, Any], address: str) -> bool:
    current = current_client(address)
    if current is None:
        return False
    if workspace_name(current) != str(saved.get("workspace") or ""):
        return False
    if bool(current.get("floating", False)):
        return False
    return (
        pair_matches(current.get("at"), saved.get("at"), max(GEOMETRY_TOLERANCE, 12))
        and pair_matches(current.get("size"), saved.get("size"), max(GEOMETRY_TOLERANCE, 12))
    )

def apply_final_state(saved: dict[str, Any], address: str) -> None:
    selector = lua_string(f"address:{address}")
    if bool(saved.get("was_pinned", False)):
        dispatch(f'hl.dsp.window.pin({{ action = "on", window = {selector} }})')
    else:
        dispatch(f'hl.dsp.window.pin({{ action = "off", window = {selector} }})')

    fullscreen = bounded_int(saved.get("fullscreen", 0), 0, 0, 2)
    if fullscreen:
        mode = "fullscreen" if fullscreen >= 2 else "maximized"
        dispatch(
            "hl.dsp.window.fullscreen({ "
            f'mode = {lua_string(mode)}, action = "set", window = {selector}'
            " })"
        )

def geometry_matches(saved: dict[str, Any], address: str) -> bool:
    current = current_client(address)
    if current is None:
        return False

    saved_floating = bool(saved.get("was_floating", False))
    if (
        workspace_name(current) != str(saved.get("workspace") or "")
        or bool(current.get("floating", False)) != saved_floating
    ):
        return False

    if not saved_floating:
        return True

    if not pair_matches(current.get("size"), saved.get("size")):
        return False
    if not pair_matches(current.get("at"), saved.get("at")):
        return False
    return True

def load_session(name: str | None) -> int:
    path, payload = read_session(name)
    saved_windows = sorted(
        [item for item in payload["windows"] if isinstance(item, dict)],
        key=lambda item: (
            str(item.get("workspace") or ""),
            bool(item.get("was_floating", False)),
            (valid_pair(item.get("at")) or [0, 0])[1],
            (valid_pair(item.get("at")) or [0, 0])[0],
            int(item.get("order", 0)),
        ),
    )

    trees = payload.get("dwindle_trees", {})
    layouts = payload.get("workspace_layouts", {})
    if not isinstance(trees, dict):
        trees = {}
    if not isinstance(layouts, dict):
        layouts = {}

    global_layout = current_general_layout()
    exact_workspaces = {
        workspace
        for workspace, tree in trees.items()
        if isinstance(workspace, str)
        and isinstance(tree, dict)
        and layouts.get(workspace) == "dwindle"
        and (not global_layout or global_layout == "dwindle")
    }

    staging_workspace = f"special:__fnsession_stage_{os.getpid()}"
    current = clients()
    exact_matches, used = reserve_exact_matches(saved_windows, current)
    failed: set[int] = set()
    restored_windows: list[tuple[int, dict[str, Any], str]] = []
    staged_orders: dict[int, str] = {}

    for index, saved in enumerate(saved_windows):
        window = exact_matches.get(index)
        if window is None:
            window = best_match(saved, current, used)
        if window is None:
            known = {
                str(item.get("address") or "")
                for item in clients()
                if item.get("address")
            }
            window = launch_window(saved, known)
            current = clients()

        if window is None:
            label = (
                saved.get("title") or saved.get("initial_class") or saved.get("class")
            )
            print(f"Warning: could not restore {label!r}", file=sys.stderr)
            failed.add(index)
            continue

        address = str(window.get("address") or "")
        workspace = str(saved.get("workspace") or "")
        is_exact_tiled = (
            workspace in exact_workspaces
            and not bool(saved.get("was_floating", False))
            and bounded_int(saved.get("fullscreen", 0), 0, 0, 2) == 0
        )

        try:
            if is_exact_tiled:
                stage_dwindle_window(address, staging_workspace)
                staged_orders[int(saved.get("order", index))] = address
            else:
                apply_geometry(saved, address)
        except FnSessionError as error:
            print(f"Warning: {address}: {error}", file=sys.stderr)
            failed.add(index)

        used.add(address)
        restored_windows.append((index, saved, address))

    restored_addresses = {address for _index, _saved, address in restored_windows}
    live_now = clients()
    for workspace in list(exact_workspaces):
        foreign = [
            item for item in live_now
            if workspace_name(item) == workspace
            and not bool(item.get("floating", False))
            and str(item.get("address") or "") not in restored_addresses
        ]
        if foreign:
            print(
                f"Warning: workspace {workspace!r} contains unrelated tiled windows; "
                "skipping exact dwindle reconstruction.",
                file=sys.stderr,
            )
            exact_workspaces.remove(workspace)

    for workspace in sorted(exact_workspaces):
        tree = trees.get(workspace)
        if not isinstance(tree, dict):
            continue

        orders = set(_tree_orders(tree))
        addresses = {order: staged_orders[order] for order in orders if order in staged_orders}
        try:
            restore_dwindle_tree(workspace, tree, addresses)
        except FnSessionError as error:
            print(f"Warning: exact dwindle restore for {workspace!r} failed: {error}", file=sys.stderr)

            for index, saved, address in restored_windows:
                if (
                    str(saved.get("workspace") or "") == workspace
                    and int(saved.get("order", index)) in staged_orders
                ):
                    try:
                        apply_geometry(saved, address)
                    except FnSessionError:
                        failed.add(index)
            exact_workspaces.discard(workspace)

    for index, saved, address in restored_windows:
        if index in failed or bool(saved.get("was_floating", False)):
            continue
        workspace = str(saved.get("workspace") or "")
        order = int(saved.get("order", index))
        if order in staged_orders and workspace not in exact_workspaces:
            try:
                apply_geometry(saved, address)
            except FnSessionError as error:
                print(f"Warning: {address}: {error}", file=sys.stderr)
                failed.add(index)

    for index, saved, address in restored_windows:
        if index in failed:
            continue
        workspace = str(saved.get("workspace") or "")
        exact_tiled = (
            workspace in exact_workspaces
            and not bool(saved.get("was_floating", False))
            and int(saved.get("order", index)) in staged_orders
        )
        try:
            if bool(saved.get("was_floating", False)):
                apply_geometry(saved, address)
            elif exact_tiled:
                apply_tiled_flags(saved, address)

            apply_final_state(saved, address)

            matches = (
                exact_tiled_geometry_matches(saved, address)
                if exact_tiled
                else geometry_matches(saved, address)
            )
            if not matches:
                time.sleep(POLL_INTERVAL)
                if bool(saved.get("was_floating", False)):
                    apply_geometry(saved, address)
                elif not exact_tiled:
                    apply_geometry(saved, address)
                matches = (
                    exact_tiled_geometry_matches(saved, address)
                    if exact_tiled
                    else geometry_matches(saved, address)
                )
            if not matches:
                raise FnSessionError("Hyprland did not keep the requested geometry/state")
        except FnSessionError as error:
            print(f"Warning: {address}: {error}", file=sys.stderr)
            failed.add(index)

    live_clients = clients()
    swallowed_addresses = {
        str(current.get("swallowing") or "")
        for current in live_clients
        if str(current.get("swallowing") or "") not in {"", "0x0"}
    }
    for index, saved, address in restored_windows:
        if address not in swallowed_addresses or index in failed:
            continue
        try:
            if bool(saved.get("was_floating", False)):
                apply_geometry(saved, address)
            else:
                apply_tiled_flags(saved, address)
        except FnSessionError as error:
            print(f"Warning: {address}: {error}", file=sys.stderr)
            failed.add(index)

    workspace = str(payload.get("active_workspace") or "")
    if workspace:
        dispatch(f"hl.dsp.focus({{ workspace = {lua_workspace(workspace)} }})")

    restored = len(saved_windows) - len(failed)
    exact_count = len(exact_workspaces)
    if exact_count:
        print(f"Restored exact native dwindle layout on {exact_count} workspace(s)")
    print(f"Loaded {restored}/{len(saved_windows)} window(s) from {path}")
    return 1 if failed else 0

def parser() -> argparse.ArgumentParser:
    cli = argparse.ArgumentParser(
        prog="fnsession",
        description="Save and restore Hyprland window sessions.",
    )
    commands = cli.add_subparsers(dest="action", required=True)
    save = commands.add_parser("save", help="save the current layout")
    save.add_argument("name", nargs="?", help="session name (default: current date)")
    save.add_argument("--quiet", action="store_true", help="do not print a success message")
    load = commands.add_parser("load", help="load a saved layout")
    load.add_argument("name", nargs="?", help="session name (default: latest)")
    list_cmd = commands.add_parser("list", help="list saved sessions")
    list_cmd.add_argument("--json", action="store_true", help="print a JSON array for integrations")
    watch = commands.add_parser("watch", help="continuously update a crash-safe rolling session")
    watch.add_argument("name", nargs="?", default="auto", help="rolling session name (default: auto)")
    watch.add_argument(
        "--interval",
        type=float,
        default=WATCH_INTERVAL,
        help=f"poll interval in seconds (default: {WATCH_INTERVAL:g})",
    )
    return cli

def main() -> int:
    arguments = parser().parse_args()
    try:
        if arguments.action == "save":
            return save_session(arguments.name, quiet=arguments.quiet)
        if arguments.action == "watch":
            return watch_session(arguments.name, arguments.interval)
        if arguments.action == "list":
            return list_sessions(arguments.json)
        return load_session(arguments.name)
    except FnSessionError as error:
        print(f"fnsession: {error}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    raise SystemExit(main())
