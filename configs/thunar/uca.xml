	<patterns>*.7z;*.bz2;*.bzip2;*.cb7;*.cbr;*.cbt;*.cbz;*.gz;*.gzip;*.iso;*.lz;*.lz4;*.lzma;*.rar;*.tar;*.tar.bz2;*.tar.gz;*.tar.lz;*.tar.lz4;*.tar.xz;*.tar.zst;*.tbz;*.tbz2;*.tgz;*.txz;*.xz;*.zip;*.zst;*.7Z;*.RAR;*.TAR;*.ZIP</patterns>
	<other-files/>
</action>
