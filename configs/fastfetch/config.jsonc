{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "right": 3,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#1}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    },
    {
      "type": "os",
      "key": "{#1}┃ {#} OS",
    },
    {
      "type": "host",
      "key": "{#1}┃ {#}󰌢 Host",
    },
    {
      "type": "custom",
      "format": "{#1}┃",
    },
    {
      "type": "uptime",
      "key": "{#1}┃ {#}󰥔 Uptime",
    },
    {
      "type": "custom",
      "format": "{#1}┃",
    },
    {
      "type": "shell",
      "key": "{#1}┃ {#} Shell",
    },
    {
      "type": "display",
      "key": "{#1}┃ {#}󰸉 Display",
    },
    {
      "type": "wm",
      "key": "{#1}┃ {#}󰄵 WM",
    },
    {
      "type": "custom",
      "format": "{#1}┃",
    },
    {
      "type": "cpu",
      "key": "{#1}┃ {#}󰘚 CPU",
    },
    {
      "type": "gpu",
      "key": "{#1}┃ {#}󰾲 GPU",
    },
    {
      "type": "memory",
      "key": "{#1}┃ {#}󰾆 Memory",
    },
    {
      "type": "swap",
      "key": "{#1}┃ {#}󰓆 Swap",
    },
    {
      "type": "custom",
      "format": "{#1}┃",
    },
    {
      "type": "disk",
      "key": "{#1}┃ {#}󰉖 Disk",
      "folders": "/",
    },
    {
      "type": "custom",
      "format": "{#1}┃",
    },
    {
      "type": "localip",
      "key": "{#1}┃ {#}󰩟 Local IP",
    },
    {
      "type": "custom",
      "format": "{#1}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    },
  ],
}
